{
    "version": 4,
    "include": [
        "base.json"
    ],
    "configurePresets": [
        {
            "name": "macos",
            "inherits": [
                "host-macos",
                "target-macos",
                "xcode",
                "default"
            ]
        },
        {
            "name": "macos-arm64",
            "inherits": [
                "macos"
            ],
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "OPENSSL_TARGET_PLATFORM": "darwin64-arm64-cc"
            }
        },
        {
            "name": "macos-x86_64",
            "inherits": [
                "macos"
            ],
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "x86_64",
                "OPENSSL_TARGET_PLATFORM": "darwin64-x86_64-cc"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "macos",
            "configurePreset": "macos",
            "inherits": [
                "host-macos"
            ]
        },
        {
            "name": "macos-arm64",
            "configurePreset": "macos-arm64",
            "inherits": [
                "host-macos"
            ]
        },
        {
            "name": "macos-x86_64",
            "configurePreset": "macos-x86_64",
            "inherits": [
                "host-macos"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "macos",
            "configurePreset": "macos",
            "inherits": [
                "host-macos",
                "options"
            ]
        },
        {
            "name": "macos-arm64",
            "configurePreset": "macos-arm64",
            "inherits": [
                "host-macos",
                "options"
            ]
        },
        {
            "name": "macos-x86_64",
            "configurePreset": "macos-x86_64",
            "inherits": [
                "host-macos",
                "options"
            ]
        }
    ]
}